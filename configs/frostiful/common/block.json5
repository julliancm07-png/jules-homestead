{
	// When enabled, icicles hanging from a ceiling will have a chance to become unstable and fall.
	enableIcicleInstability: false,
	// If icicle instability is enabled, multiplies the chance that an icicle hanging from a ceiling will become unstable and fall. Must be at least 0.
	icicleInstabilityChanceMultiplier: 1.0,
	// Multiplies the chance that an icicle hanging from a ceiling will attempt to grow. Must be at least 0.
	icicleGrowthChanceMultiplier: 1.0,
	// Multiplies the duration that a Hot Sun Lichen will burn a warm entity that touches it. Must be at least 0.
	sunLichenBurnTimeMultiplier: 1.0,
	// Multiplies the range of the Warmth effect applied to entities around a Campfire, after adding a log. The base range is 10 blocks. Must be at least 0.
	campfireWarmthSearchRadiusMultiplier: 1.0,
	// Multiplies the duration of the Warmth effect that will be applied to entities near a campfire when a log is added to it. Must be at least 0.
	campfireWarmthTimeMultiplier: 1.0
}