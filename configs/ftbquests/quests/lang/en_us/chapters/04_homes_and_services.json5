{
  "chapter.68442426B9825A3A.title": "Homes & Services",
  "chapter.68442426B9825A3A.chapter_subtitle": [
    "From camp to homestead: a real house, a workshop and the first services."
  ],
  "quest.5A1B6E5B5AB50F53.title": "[Manual] A Proper House",
  "quest.5A1B6E5B5AB50F53.quest_desc": [
    "Walls, a roof, a door you can close, windows, light, a bed and storage.",
    "Macaw's Doors, Windows, Roofs, Furniture and Lights give you plenty to build with. Rechiseled adds decorative block patterns.",
    "",
    "This is a building milestone. FTB Quests cannot reliably judge architecture, so tick the checkbox yourself when you are happy with it."
  ],
  "quest.2BB2CF47442FAB11.title": "[Manual] Making It Home",
  "quest.2BB2CF47442FAB11.quest_desc": [
    "Tables, chairs, a wardrobe, a rug. Comfort is the point of a homestead.",
    "Kitchen cabinets and drawers from Storage Delight and Macaw's Furniture actually store things.",
    "",
    "This is a building milestone. FTB Quests cannot reliably judge architecture, so tick the checkbox yourself when you are happy with it."
  ],
  "quest.23C2DA9DBDF52695.title": "Put Your Feet Up",
  "quest.23C2DA9DBDF52695.quest_desc": [
    "Adorn adds sofas, chairs, tables, shelves and kitchen fittings in every wood and colour. Beautify adds blinds, trellises, lamps and hanging pots.",
    "You can also sit on stairs and slabs: right-click the top of one with an empty hand, and sneak to stand up."
  ],
  "task.5459123AF46DA690.title": "Get any sofa",
  "task.6D5672DAF8A7C0E6.title": "Make a hanging pot",
  "quest.7E8F3FAB4AED047A.title": "[Manual] Paths and Lamps",
  "quest.7E8F3FAB4AED047A.quest_desc": [
    "Link your buildings with paths (Macaw's Paths & Pavings) and light them so mobs don't spawn between your doors.",
    "",
    "This is a building milestone. FTB Quests cannot reliably judge architecture, so tick the checkbox yourself when you are happy with it."
  ],
  "quest.36367BB06A9B502D.title": "Builder's Tools",
  "quest.36367BB06A9B502D.quest_desc": [
    "Effortless Building can mirror, repeat and draw lines of blocks. The randomizer mixes materials for natural-looking walls."
  ],
  "quest.5DF0C9E1294674CA.title": "A Tidy Pantry",
  "quest.5DF0C9E1294674CA.quest_desc": [
    "Drawers hold large amounts of one item each: grain, flour, seeds. (The quest asks for oak 2x2 drawers, but any wood works the same.)"
  ],
  "quest.13C134EF069F0169.title": "[Manual] The Workshop",
  "quest.13C134EF069F0169.quest_desc": [
    "A separate building for crafting, smelting and, soon, machines. Leave space for power equipment and run cable inside the walls.",
    "",
    "This is a building milestone. FTB Quests cannot reliably judge architecture, so tick the checkbox yourself when you are happy with it."
  ],
  "quest.61F3021CF968CEF6.title": "Packed for the Road",
  "quest.10DBC4918D980A19.title": "Waystone",
  "quest.10DBC4918D980A19.quest_desc": [
    "Put a waystone at your homestead and you can always find your way back. Build more at distant villages and outposts."
  ],
  "task.7FB373342CEF2E46.title": "Look at a waystone you placed",
  "quest.2B9A4BB4235D8398.title": "[Manual] A Homestead",
  "quest.2B9A4BB4235D8398.quest_desc": [
    "House, fields, barn, cellar, workshop. A place worth defending from the weather. Tick when it feels like a homestead.",
    "",
    "This is a building milestone. FTB Quests cannot reliably judge architecture, so tick the checkbox yourself when you are happy with it."
  ]
}
